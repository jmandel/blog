---
import BaseLayout from './BaseLayout.astro';

export interface Props {
  title: string;
  date: Date;
  description?: string;
  linkUrl?: string;
  linkLabel?: string;
}

const { title, date, description, linkUrl, linkLabel = 'Original on LinkedIn' } = Astro.props;

function formatDate(date: Date): string {
  return date.toLocaleDateString('en-US', {
    year: 'numeric',
    month: 'long',
    day: 'numeric'
  });
}
---

<BaseLayout title={title} description={description}>
  <a href="/blog" class="back-link">Back to posts</a>
  <div class="post-grid">
  <article>
    <header>
      <h1>{title}</h1>
      <time class="post-date" datetime={date.toISOString()}>
        Published on {formatDate(date)}
      </time>
      {linkUrl && (
        <a class="post-link-chip" href={linkUrl} target="_blank" rel="noreferrer">
          {linkLabel}
        </a>
      )}
    </header>
    <div class="prose">
      <slot />
    </div>
  </article>
  <slot name="aside" />
  </div>
</BaseLayout>

<style is:global>
  /* With a LinkedIn conversation and room for it, show it beside the
     article: the page widens, the article keeps its reading width, and the
     conversation scrolls on its own while staying in view. */
  @media (min-width: 1300px) {
    .main:has(.post-grid > .li-conv) {
      max-width: 1260px;
    }
    .post-grid:has(> .li-conv) {
      display: grid;
      grid-template-columns: minmax(0, 720px) minmax(360px, 1fr);
      gap: 3rem;
      align-items: start;
    }
    .post-grid > .li-conv {
      position: sticky;
      top: 1rem;
      max-height: calc(100vh - 2rem);
      overflow-y: auto;
      margin-top: 0 !important;
      padding-top: 0 !important;
      border-top: 0 !important;
      padding-right: 0.5rem;
    }
  }
</style>

<style>
  header {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    margin-bottom: 1.5rem;
  }

  .post-link-chip {
    align-self: flex-start;
    font-size: 0.85rem;
    font-weight: 500;
    color: #1e3a8a;
    text-decoration: none;
    padding: 0.25rem 0.6rem;
    border-radius: 9999px;
    background: rgba(30, 58, 138, 0.08);
    transition: background-color 0.2s ease;
  }

  .post-link-chip:hover {
    background: rgba(30, 58, 138, 0.14);
  }
</style>
