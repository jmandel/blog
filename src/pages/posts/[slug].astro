---
import { getPosts } from '../../lib/posts';
import PostLayout from '../../layouts/PostLayout.astro';
import LinkedInThreads from '../../components/LinkedInThreads.astro';
import { entryForPost, watchUrl } from '../../lib/youtube.mjs';

export async function getStaticPaths() {
  const posts = await getPosts();
  return posts.map((post) => ({
    params: { slug: post.data.slug ?? post.slug },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await post.render();
const bannerImage = post.data.banner;
const originalUrl = post.data.original_url;
const introShare = post.data.intro_share;
const alsoPosted = (post.data.also_posted ?? []).map((ap) => ({
  label: `Also posted on LinkedIn, ${new Date(ap.posted_at).toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })}`,
  paragraphs: (ap.commentary ?? '').trim().split(/\n{2,}/).map((x) => x.trim()).filter(Boolean),
}));
const introShareCommentary = introShare?.commentary?.trim();
// A video in the intro post, if src/data/youtube.json knows about it.
const introVideo = introShare?.share_id ? entryForPost(introShare.share_id) : null;
// LinkedIn threads for this page: the article's (imported, or superseded by
// this native post) and those of posts about it.
const articleId = (v?: string) =>
  v && (/^[a-z0-9]{5}$/.test(v) ? v : v.match(/linkedin\.com\/pulse\/[^?#]*-([a-z0-9]{5})\/?(?:[?#]|$)/)?.[1]);
const supersedes = post.data.supersedes_linkedin;
const threadKeys = [
  post.data.linkedin_id,
  articleId(originalUrl),
  ...(Array.isArray(supersedes) ? supersedes : supersedes ? [supersedes] : []).map(articleId),
].filter(Boolean).map((id) => `article:${id}`);
if (introShare?.share_id) threadKeys.push(`share:${introShare.share_id}`);
---

<PostLayout 
  title={post.data.title} 
  date={new Date(post.data.date)}
  description={post.data.description}
  linkUrl={originalUrl}
  linkLabel="Original on LinkedIn"
>
  {bannerImage && (
    <img src={bannerImage.src} alt="" />
  )}
  {introShare && (
    <aside class="intro-share">
      <div class="intro-share__meta">
        <span>Introduced on LinkedIn</span>
      </div>
      {introShareCommentary && (
        <div class="intro-share__body">
          {introShareCommentary
            .split(/\n{2,}/)
            .map((paragraph) => paragraph.trim())
            .filter(Boolean)
            .map((paragraph) => (
            <p>{paragraph}</p>
          ))}
        </div>
      )}
      {introVideo && (
        <div class="intro-share__video">
          {introVideo.youtube_id ? (
            <figure class="yt-embed">
              <a class="yt-embed__facade" href={watchUrl(introVideo.youtube_id)} data-yt={introVideo.youtube_id} aria-label="Play video">
                <img src={`https://i.ytimg.com/vi/${introVideo.youtube_id}/hqdefault.jpg`} alt="" loading="lazy" />
                <span class="yt-embed__play" aria-hidden="true"></span>
              </a>
              <figcaption><a href={watchUrl(introVideo.youtube_id)}>Watch on YouTube</a></figcaption>
            </figure>
          ) : (
            <p><a href={introShare.share_url}>Watch the video on LinkedIn</a></p>
          )}
          {(introVideo.related ?? []).map((r) => (
            <p class="yt-related"><a href={watchUrl(r.youtube_id)}>{r.label ?? 'Related video on YouTube'}</a></p>
          ))}
        </div>
      )}
    </aside>
  )}
  {introVideo?.youtube_id && (
    <script is:inline>
      document.addEventListener('click', function (e) {
        var a = e.target.closest && e.target.closest('a[data-yt]');
        if (!a) return;
        e.preventDefault();
        var f = document.createElement('iframe');
        f.src = 'https://www.youtube-nocookie.com/embed/' + a.dataset.yt + '?autoplay=1&rel=0';
        f.title = a.getAttribute('aria-label') || 'YouTube video';
        f.allow = 'accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture';
        f.allowFullscreen = true;
        f.className = 'yt-embed__frame';
        a.replaceWith(f);
      });
    </script>
  )}
  {alsoPosted.map((ap) => (
    <aside class="intro-share">
      <div class="intro-share__meta">
        <span>{ap.label}</span>
      </div>
      {ap.paragraphs.length > 0 && (
        <div class="intro-share__body">
          {ap.paragraphs.map((paragraph) => (
            <p>{paragraph}</p>
          ))}
        </div>
      )}
    </aside>
  ))}
  <Content />
  <LinkedInThreads slot="aside" keys={threadKeys} />
</PostLayout>

<style>
  .intro-share {
    margin: 1.5rem 0;
    padding: 1rem 1.15rem;
    border-radius: 0.9rem;
    border: 1px solid rgba(30, 58, 138, 0.12);
    background: rgba(30, 58, 138, 0.04);
  }

  .intro-share__meta {
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    font-size: 0.9rem;
    color: #1f3b7a;
    font-weight: 500;
    margin-bottom: 0.5rem;
  }

  .intro-share__meta span:first-child {
    text-transform: uppercase;
    letter-spacing: 0.04em;
    font-size: 0.78rem;
    color: #64748b;
  }

  .intro-share__button {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    padding: 0.28rem 0.85rem;
    border-radius: 9999px;
    background: rgba(37, 99, 235, 0.12);
    color: #1d4ed8;
    text-decoration: none;
    font-size: 0.82rem;
    font-weight: 600;
    transition: background-color 0.2s ease, color 0.2s ease;
  }

  .intro-share__button:hover {
    background: rgba(37, 99, 235, 0.2);
    color: #1e3a8a;
  }

  .intro-share__body {
    margin-top: 0.85rem;
    font-size: 0.95rem;
    color: #334155;
  }

  .intro-share__body p {
    margin: 0 0 0.75rem;
  }

  .intro-share__body p:last-child {
    margin-bottom: 0;
  }
</style>
